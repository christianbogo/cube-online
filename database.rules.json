{
  "rules": {
    "presence": {
      ".read": true,
      ".indexOn": ["timestamp"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'timestamp']) && newData.child('uid').val() === auth.uid",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'IDLE' || newData.val() == 'INSPECTION' || newData.val() == 'PRIMING' || newData.val() == 'RUNNING' || newData.val() == 'SOLVED' || newData.val() == 'idle' || newData.val() == 'inspecting' || newData.val() == 'solving')"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "lastSolveTime": {
          ".validate": "newData.val() == null || newData.isNumber()"
        },
        "recentSolves": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}